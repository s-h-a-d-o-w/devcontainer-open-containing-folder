{
  "name": "devcontainer-open-containing-folder",
  "displayName": "Devcontainer Open Containing Folder",
  "version": "1.0.3",
  "description": "Seamlessly open folders in devcontainers.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "context menu",
    "dev containers",
    "devcontainer",
    "explorer",
    "file manager",
    "reveal",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-h-a-d-o-w/devcontainer-open-containing-folder"
  },
  "publisher": "s-h-a-d-o-w",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.ts --production",
    "dev": "node esbuild.ts",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "package": "pnpm build && vsce package --no-dependencies",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "devcontainer-open-containing-folder.revealInExplorer",
        "title": "Open Containing Folder"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "devcontainer-open-containing-folder.revealInExplorer",
          "when": "remoteName == dev-container",
          "group": "navigation@1000"
        }
      ],
      "editor/title/context": [
        {
          "command": "devcontainer-open-containing-folder.revealInExplorer",
          "when": "remoteName == dev-container",
          "group": "2_files"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+alt+r",
        "command": "devcontainer-open-containing-folder.revealInExplorer",
        "when": "editorTextFocus && remoteName == dev-container"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
