{
  "name": "devcontainer-open-containing-folder",
  "displayName": "Devcontainer Open Containing Folder",
  "version": "1.2.2",
  "description": "Seamlessly open foldersin devcontainers.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "context menu",
    "explorer",
    "file manager",
    "remote-ssh",
    "reveal",
    "windows"
  ],
  "homepage": "https://github.com/sbaillou/vscode-remote-ssh-reveal-explorer#readme",
  "bugs": {
    "url": "https://github.com/sbaillou/vscode-remote-ssh-reveal-explorer/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Andreas Opferkuch",
    "url": "https://marketplace.visualstudio.com/publishers/s-h-a-d-o-w"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s-h-a-d-o-w/devcontainer-open-containing-folder"
  },
  "publisher": "s-h-a-d-o-w",
  "main": "./dist/extension.js",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "package": "pnpm build && vsce package --no-dependencies",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "open": "^10.2.0",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "remote-ssh-reveal-explorer.revealInExplorer",
        "title": "Remote-SSH Reveal in File Explorer"
      },
      {
        "command": "remote-ssh-reveal-explorer.test",
        "title": "Test Remote-SSH Reveal Extension"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "remote-ssh-reveal-explorer.revealInExplorer",
          "when": "remoteName == ssh-remote",
          "group": "6_copypath@1000"
        }
      ],
      "editor/title/context": [
        {
          "command": "remote-ssh-reveal-explorer.revealInExplorer",
          "when": "remoteName == ssh-remote",
          "group": "2_files"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Remote-SSH Reveal",
      "properties": {
        "remote-ssh-reveal-explorer.networkPath": {
          "type": "string",
          "default": "",
          "description": "Path to the network folder of the Remote-SSH machine.",
          "scope": "window"
        },
        "remote-ssh-reveal-explorer.pathPrefixToStrip": {
          "type": "string",
          "default": "",
          "description": "Prefix to strip from the remote path.",
          "scope": "window"
        }
      }
    },
    "keybindings": [
      {
        "key": "shift+alt+r",
        "command": "remote-ssh-reveal-explorer.revealInExplorer",
        "when": "editorTextFocus && remoteName == 'ssh-remote'"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "assets/imgs/logo.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
